{
  "name": "realtorch-atlas-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "expo": "~57.0.16",
    "expo-asset": "~57.0.14",
    "expo-audio": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-dev-client": "~57.0.15",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-sharing": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "memory:verify:messy": "node --env-file=server/.env server/verify-meeting-memory-messy.mjs",

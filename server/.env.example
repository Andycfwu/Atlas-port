OPENAI_API_KEY=
PORT=8787

# Meeting Memory uses the existing server-only key above.
# Optional model overrides; changing embeddings requires reprocessing meetings.
MEMORY_ORGANIZE_MODEL=gpt-5.6-sol
MEMORY_ANSWER_MODEL=gpt-5.6-sol
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# Optional absolute SQLite path. Default: server/data/meeting-memory.sqlite
# MEMORY_DB_PATH=/absolute/path/to/meeting-memory.sqlite

# Public client configuration only. Never place secrets in EXPO_PUBLIC_* values.
# Physical devices must use the Mac's LAN IP, not localhost.
# Example: http://192.168.1.42:8787
EXPO_PUBLIC_API_URL=

# Development diagnostics only. Shows manual raw and production-path tests.
EXPO_PUBLIC_RECORDER_INTEGRITY_MODE=0
EXPO_PUBLIC_MINIMAL_RECORDER_REPRO=0
EXPO_PUBLIC_MINIMAL_RECORDER_AUTORUN=0
